# Copy this file to .env and fill in your key. .env is ignored by git.
TAVUS_API_KEY=paste-your-key-here

# Stock Phoenix-3 face used in the Tavus quickstart. Swap for the face you pick later.
TAVUS_FACE_ID=rc9cff32ceba

# Hosted demo only (set these in the hosting platform, not here):
# TAVUS_PAL_ID=        the pal_id from .agent.json, since .agent.json isn't deployed
# DEMO_ACCESS_CODE=    code reviewers enter before starting a call
# MAX_CALLS_PER_HOUR=10
# MAX_CALL_SECONDS=300
